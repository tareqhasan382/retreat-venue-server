# NestJS
PORT=5000
NODE_ENV=development

# Postgres (Docker service name)
DATABASE_USER=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=example_db
DATABASE_URL="postgresql://postgres:password123@localhost:5433/example_db?schema=public"


# Redis (Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=123456

# Authentication
SALT_ROUND=13
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIREIN=''
REFRESH_TOKEN_EXPIREIN=''

# Admin
SUPER_ADMIN_EMAIL=superAdmin@gmail.com
SUPER_ADMIN_PASSWORD=123456

# SMTP / Stripe / Cloudinary (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=





