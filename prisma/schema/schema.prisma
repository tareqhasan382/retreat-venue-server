generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS (Structured Data Definitions)
// ----------------------------------------------------
// User account status
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPEND
}

// User role for authorization and feature access
enum UserRole {
  ADMIN // Full system access, platform-wide controls
  MODARATOR
  USER
}
